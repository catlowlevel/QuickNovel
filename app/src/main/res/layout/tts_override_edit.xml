<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/scope"
                style="@style/Theme.Widget.Tabs.Pill"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/tts_override_scope" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/enabled"
                style="@style/WhiteCheckmark"
                android:layout_width="wrap_content"
                android:minHeight="48dp"
                android:text="@string/tts_override_enabled"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/scope_hint"
            style="@style/AppTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="?attr/grayTextColor"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/find_label"
            style="@style/AppTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/find"
            android:text="@string/tts_override_find"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/find"
            style="@style/AppEditStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="3"
            android:textSize="16sp"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/duplicate_warning"
            style="@style/AppTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            style="@style/AppTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/replacement"
            android:text="@string/tts_override_replacement"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/replacement"
            style="@style/AppEditStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="3"
            android:textSize="16sp"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/replacement_hint"
            style="@style/AppTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tts_override_replacement_hint"
            android:textColor="?attr/grayTextColor"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/regex"
                style="@style/WhiteCheckmark"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/tts_override_regex_short"
                android:textSize="14sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/case_sensitive"
                style="@style/WhiteCheckmark"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/tts_override_case_sensitive"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/help_toggle"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:fontFamily="@font/google_sans"
            android:text="@string/tts_override_show_help"
            android:textAllCaps="false"
            android:textColor="?attr/textColor"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/help_details"
            style="@style/AppTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/tts_override_regex_replacement_hint"
            android:textColor="?attr/grayTextColor"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
